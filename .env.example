# LLM — openai | openai_compat | anthropic
NBLOG_PROVIDER=openai
NBLOG_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# 로컬·호환 서버는 전용 어댑터 없이 이 두 줄이면 됩니다.
# NBLOG_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Anthropic
# NBLOG_PROVIDER=anthropic
# NBLOG_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# 네이버 검색·데이터랩 (글쓰기 API 아님. 리서치 전용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 본인 블로그 발행(Playwright). 비밀번호는 넣지 마세요.
# 한 번 `nblog login`으로 브라우저에 직접 로그인합니다.
NAVER_BLOG_ID=
NBLOG_CHROME_PROFILE=.chrome-profile

# 데이터 디렉터리 (기본: ./data)
# NBLOG_DATA_DIR=./data

# 공개 발행 최소 간격(시간). 기본 6
# NBLOG_MIN_PUBLISH_HOURS=6
