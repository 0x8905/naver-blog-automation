# LLM 키. provider/model은 taste/<name>/taste.json 의 llm 블록이 정합니다.
OPENAI_API_KEY=
# 아래 두 줄의 주석을 풀면 taste 설정을 덮어씁니다 (환경변수가 우선).
# openai | openai_compat | anthropic
# NBLOG_PROVIDER=openai
# NBLOG_MODEL=gpt-4o-mini
# 로컬·호환 서버는 전용 어댑터 없이 이 두 줄이면 됩니다.
# NBLOG_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Anthropic
# NBLOG_PROVIDER=anthropic
# NBLOG_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# 네이버 검색·데이터랩 (글쓰기 API 아님. 리서치 전용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 본인 블로그 발행(Playwright). 비밀번호는 넣지 마세요.
# 한 번 `nblog login`으로 브라우저에 직접 로그인합니다.
NAVER_BLOG_ID=
NBLOG_CHROME_PROFILE=.chrome-profile
# 기본은 `playwright install chromium` 으로 받은 번들 Chromium.
# 설치된 브라우저를 쓰려면: chrome | msedge
# NBLOG_BROWSER_CHANNEL=chrome

# 데이터 디렉터리 (기본: ./data)
# NBLOG_DATA_DIR=./data

# 공개 발행 최소 간격(시간). 기본 6
# NBLOG_MIN_PUBLISH_HOURS=6
